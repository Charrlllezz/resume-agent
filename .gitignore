# Your resume and your job search. Everything here is personal: the resume
# itself, which companies you applied to, and a model's private read on each
# one. Committing any of it means a recruiter at a company you marked "skip"
# can read that you did.
master_resume.json
master_resume.backup.json
resumes/
tailored_*
applications.csv
tracker.csv

# Job lists and pipeline output
saved_jobs.tsv
resolved.tsv
resolved_unresolved.json
ranked.tsv
roles.tsv
*_candidates.tsv
*.log

# Caches
rank_cache.json
compare_cache.json
compare_results.json

# Runtime state: the trial ledger. Counts and dollars, no keys and no
# resumes -- but it is this deployment's, not the project's.
.state/

__pycache__/
.venv/
.env
